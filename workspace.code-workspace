{
    "folders": [
        {
            "path": ".",
        },
    ],
    "settings": {
        "files.exclude": {
            "**/.git": true,
            "**/.svn": true,
            "**/.hg": true,
            "**/CVS": true,
            "**/.DS_Store": true,
            "**/Thumbs.db": true,
            "**/.ruby-lsp": true,
            "public": true,
        },
        "search.exclude": {
            "**/node_modules": true,
            "**/bower_components": true,
            "**/*.code-search": true,
            "**/.ruby-lsp": true,
            "public": true,
        },
        "markdownlint.config": {
            "MD028": false,
            "MD025": {
                "front_matter_title": "",
            },
            "MD033": false,
        },
        "json.schemas": [
            {
                "fileMatch": ["data/recognizer_registry/**/*.json"],
                "url": "file:static/registry_schema.json",
            },
        ],
        "yaml.schemaStore.enable": true,
        "yaml.schemas": {
            "static/registry_schema.json": "data/recognizer_registry/**/*.yml",
        },
        "editor.defaultFormatter": "esbenp.prettier-vscode",

        "editor.rulers": [80, 120],
        "prettier.enable": true,
        "prettier.tabWidth": 2,
        "prettier.useTabs": false,
        "prettier.bracketSameLine": true,
        "prettier.printWidth": 80,
        "prettier.enableDebugLogs": true,
        "prettier.disableLanguages": ["toml"],
        "editor.tabSize": 2,
        "html.format.templating": true,
        "html.format.indentHandlebars": false,
        "html.format.wrapAttributes": "preserve",
        "[html]": {
            "editor.suggest.insertMode": "replace",
            // this is causing so many templating issues with auto formatting, disabled
            // "editor.defaultFormatter": "GitHub.vscode-pull-request-github",
            "editor.defaultFormatter": "esbenp.prettier-vscode",
            "files.insertFinalNewline": false,
            "files.trimFinalNewlines": true,
        },
        "[yaml]": {
            "editor.insertSpaces": true,
            "editor.tabSize": 2,
            "editor.autoIndent": "keep",
            "editor.quickSuggestions": {
                "other": true,
                "comments": false,
                "strings": true,
            },
            "editor.defaultFormatter": "esbenp.prettier-vscode",
        },
        "evenBetterToml.formatter.indentEntries": true,
        "evenBetterToml.formatter.indentString": "  ",
        "evenBetterToml.formatter.indentTables": true,
        "[toml]": {
            "editor.insertSpaces": true,
            "editor.tabSize": 2,
            "editor.defaultFormatter": "tamasfe.even-better-toml",
            "editor.formatOnSave": true,
        },
        "[javascript]": {
            "editor.maxTokenizationLineLength": 2500,
            "editor.defaultFormatter": "esbenp.prettier-vscode",
        },
        "workbench.colorCustomizations": {
            "activityBar.activeBackground": "#d79757",
            "activityBar.activeBorder": "#15202b",
            "activityBar.background": "#d79757",
            "activityBar.foreground": "#15202b",
            "activityBar.inactiveForeground": "#15202b99",
            "activityBarBadge.background": "#ccf3df",
            "activityBarBadge.foreground": "#15202b",
            "sash.hoverBorder": "#d79757",
            "statusBarItem.hoverBackground": "#a26426",
            "statusBarItem.remoteBackground": "#7ee1b0",
            "statusBarItem.remoteForeground": "#15202b",
            "titleBar.activeBackground": "#cb7e30",
            "titleBar.activeForeground": "#15202b",
            "titleBar.inactiveBackground": "#cb7e3099",
            "titleBar.inactiveForeground": "#15202b99",
            "commandCenter.border": "#15202b99",
            "activityBarTop.activeBackground": "#d79757",
            "activityBarTop.background": "#d79757",
            "activityBarTop.foreground": "#15202b",
            "activityBarTop.inactiveForeground": "#15202b99",
            "commandCenter.foreground": "#15202b",
            "statusBar.debuggingBackground": "#cb7e30",
            "statusBar.debuggingForeground": "#15202b",
            "activityBarTop.activeBorder": "#15202b",
            "statusBar.inactiveBackground": "#cb7e30",
        },
        "peacock.color": "#CB7E30",
        "[markdown]": {
            // "editor.defaultFormatter": "esbenp.prettier-vscode",
            "editor.quickSuggestions": {
                "comments": "on",
                "strings": "on",
                "other": "on",
            },
        },
        "cSpell.words": [
            "analyse",
            "Arbimon",
            "Asciinema",
            "behaviour",
            "binomial",
            "convolutional",
            "discoverability",
            "Ecoacoustic",
            "Ecoacoustics",
            "Ecosounds",
            "favourite",
            "FLAC",
            "orcid",
            "organisation",
            "organisations",
            "Preact",
            "Rainforest",
            "recogniser",
            "recognisers",
            "specialising",
            "standardised",
            "Zenodo",
            "Ecoacoustics",
            "Ecosounds",
            "Recogniser",
            "stackblitz",
            "visualisations",
        ],
        "svg.preview.background": "transparent",
        "[svg]": {
            "editor.defaultFormatter": "jock.svg",
        },
    },
    "extensions": {
        "recommendations": [
            "kaellarkin.hugo-shortcode-syntax",
            "editorconfig.editorconfig",
            "budparr.language-hugo-vscode",
            "bierner.lit-html",
            "streetsidesoftware.code-spell-checker",
        ],
    },
}
